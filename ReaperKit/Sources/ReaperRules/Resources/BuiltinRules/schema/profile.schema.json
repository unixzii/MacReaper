{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macreaper.app/schema/profile-1.json",
  "title": "MacReaper scan profile (format 1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "title", "roots", "maxDepth", "ruleSets", "preselect"],
  "properties": {
    "format": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "roots": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(~|~/.*|/.*[^/].*)$" }
    },
    "exclude": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(/|~/)" }
    },
    "maxDepth": { "type": "integer", "minimum": 1, "maximum": 64 },
    "ruleSets": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "preselect": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["safe", "review"] }
    },
    "categorySafety": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": { "enum": ["safe", "review", "dangerous"] }
    }
  }
}
